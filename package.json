{
  "name": "personal-wiki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "build": "next build",
    "check": "pnpm lint && pnpm markdown:check && pnpm format:check && pnpm typecheck && pnpm test",
    "ci": "pnpm check && pnpm build",
    "content:check": "knotaru-docs-check-links --content-dir content/docs --base-path /docs",
    "dev": "next dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "links:check": "./scripts/ci/check-links",
    "markdown:check": "markdownlint-cli2",
    "markdown:fix": "markdownlint-cli2 --fix",
    "prepare": "husky",
    "start": "next start",
    "test": "pnpm content:check",
    "typecheck": "fumadocs-mdx && next typegen && tsc --noEmit",
    "build:pages": "node scripts/ci/build-pages.mjs"
  },
  "dependencies": {
    "@knotaru/docs-ui": "0.1.0",
    "fumadocs-core": "16.18.1",
    "fumadocs-mdx": "15.5.0",
    "fumadocs-ui": "16.18.1",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "husky": "9.1.7",
    "markdownlint-cli2": "0.24.0",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2"
  }
}
